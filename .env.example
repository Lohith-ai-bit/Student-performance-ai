# =============================================================================
# Student Performance AI — Environment configuration (copy to .env, never commit .env)
# =============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# From the host machine (backend running natively):
DATABASE_URL=postgresql+psycopg://spa_user:spa_password@localhost:5432/student_performance
# Inside docker-compose the backend reaches Postgres by service name:
# DATABASE_URL=postgresql+psycopg://spa_user:spa_password@postgres:5432/student_performance

POSTGRES_USER=spa_user
POSTGRES_PASSWORD=spa_password
POSTGRES_DB=student_performance

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-real-environments
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Service URLs
# ---------------------------------------------------------------------------
# Next.js (browser) -> FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# FastAPI base (server-side calls)
FASTAPI_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Redis (rate limiting / caching; optional in Phase 1)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# CORS (comma-separated origins)
# ---------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# ML configuration
# ---------------------------------------------------------------------------
ML_ARTIFACTS_DIR=../ml/artifacts
RISK_THRESHOLDS_LOW=0.25
RISK_THRESHOLDS_MEDIUM=0.50
RISK_THRESHOLDS_HIGH=0.75
